  "cards": [
    {
      "dot": "emerald",
      "title": "hivey core does",
      "items": [
        "One space per swarm; click it to talk to its master",
        "Solo agents (★): one agent that is its own master (launch --solo)",
        "Directory: what each swarm or agent does, skills, tools, busy or idle; ask the user before sending work",
        "Message bus: delivery when idle, --fyi never wakes, --urgent now; queues survive restarts",
        "Pause/resume, relaunch, resume after a restart; Claude Code + Codex adapters",
        "hivey update: latest version with live handoff; install.sh for new machines"
      ]
    },
    {
      "dot": "rose",
      "title": "⬢ The hivey agent",
      "items": [
        "Always-on Claude in ~/.hivey/agent, the first space (hivey home)",
        "Your main way into hivey: launch swarms, check status, ask coordinators",
        "Reachable from Slack #hivey through the relay, even with no swarms running",
        "The engine restarts it when it's gone (watchdog with backoff)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Addons (plugins)",
      "items": [
        "hivey.slack-relay: Slack @mentions → bus; mirror of master traffic",
        "hivey.dashboard: live states, token bars, budget, tasks, messages",
        "hivey.github: product and workspace as two repos, gitleaks gate",
        "swarm.watcher (/swarm skill): idle, stall and budget alerts"
      ]
    },
    {
      "dot": "violet",
      "title": "Addon contract",
      "items": [
        "Any herdr-format plugin with a pane; opened by launch --addon or swarm addon",
        "Gets HIVEY_SWARM_ROOT, _SLUG, _CHANNEL",
        "Talks in with `hivey msg send`; reads out from .swarm/bus.jsonl"
      ]
    },
    {
      "dot": "amber",
      "title": "Swappable runtime",
      "items": [
        "Runtime core = herdr today (compiled in)",
        "The engine, CLI and addons use it only through its socket API",
        "tmux or cmux can plug in as runtime drivers: designed, not built yet"
      ]
    }
  ]
